{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxly",
  "version": "0.1.0",
  "identifier": "dev.voxly.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      { "title": "Voxly", "width": 520, "height": 780, "minWidth": 380 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "infoPlist": "Info.plist", "entitlements": "Entitlements.plist" }
  }
}
